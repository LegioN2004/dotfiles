# --- Changing Focus ---
# change window focus within space
# cmd - j : yabai -m window --focus south
# cmd - k : yabai -m window --focus north
# cmd - h : yabai -m window --focus west
# cmd - l : yabai -m window --focus east

# change focus to display left and right
# cmd - s: yabai -m display --focus west
# cmd - g: yabai -m display --focus east

# Cycle through windows in the current stack
alt - j : yabai -m window --focus stack.next
alt - k : yabai -m window --focus stack.prev

# Focus the next window in the stack
alt - n : yabai -m window --focus next || yabai -m window --focus first

# Focus the previous window in the stack
alt - p : yabai -m window --focus prev || yabai -m window --focus last

# --- Modify Layout ---

# balance out tree 
# cmd - e : yabai -m space --balance

# rotate layout clockwise
# cmd - r : yabai -m space --rotate 270

# flip along y-axis
# cmd - y : yabai -m space --mirror y-axis

# flip along x-axis
# cmd - x : yabai -m space --mirror x-axis

# --- Moving Windows Arround ---

# swap windows within space
# cmd - j : yabai -m window --swap south
# cmd - k : yabai -m window --swap north
# cmd - h : yabai -m window --swap west
# cmd - l : yabai -m window --swap east

# maximize a window
# cmd - m : yabai -m window --toggle zoom-fullscreen

# toggle window float
# cmd - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# move window and split
# ctrl + cmd - j : yabai -m window --warp south
# ctrl + cmd - k : yabai -m window --warp north
# ctrl + cmd - h : yabai -m window --warp west
# ctrl + cmd - l : yabai -m window --warp east

# move window to display left and right
# cmd - s : yabai -m window --display west; yabai -m display --focus west;
# cmd - g : yabai -m window --display east; yabai -m display --focus east;

#move window to prev and next space
# cmd - p : yabai -m window --space prev;
# cmd - n : yabai -m window --space next;

# focus window
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7
cmd - 8 : yabai -m space --focus 8
cmd - 9 : yabai -m space --focus 9


# shift window focus
cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7


# stop/start/restart yabai
ctrl + cmd - q : brew services stop yabai
ctrl + cmd - s : brew services start yabai
ctrl + cmd - r : brew services restart yabai
